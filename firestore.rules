rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /usuarios/{uid} {
      allow create, read, update: if owner(uid);
      allow delete: if false;
      match /treinos/{id} { allow create, read, update, delete: if owner(uid); }
      match /avaliacoes/{id} { allow create, read, update, delete: if owner(uid); }
    }
    match /{document=**} { allow read, write: if false; }
  }
}